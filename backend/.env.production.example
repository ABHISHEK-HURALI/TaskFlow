# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your production values
# NEVER commit the .env file!

# Django Settings
SECRET_KEY=your-new-secure-random-key-here-use-daphne-generate-secret-key
DEBUG=False
ENVIRONMENT=production

# Database (MySQL Production)
# Use a managed database service (MySQL, PostgreSQL, etc.)
# For Railway: Use the MySQL database addon provided by Railway
# For Heroku: Use ClearDB MySQL addon
DB_ENGINE=django.db.backends.mysql
DB_NAME=taskflow_production
DB_USER=production_user
DB_PASSWORD=your-very-secure-password-here
DB_HOST=your-production-db-host.railway.app
DB_PORT=3306

# OR use DATABASE_URL (Railway/Heroku format)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# CORS & Security (IMPORTANT - Update with your domain)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend URLs
FRONTEND_URL=https://yourdomain.com
FRONTEND_ORIGIN=https://yourdomain.com

# Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# WebSocket / Channel Layers (Redis)
# For development: In-memory fallback
# For production: Use Redis
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer
REDIS_URL=redis://:password@host:6379/0
# or separate Redis config:
REDIS_HOST=your-redis-host.railway.app
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# Optional: Use in-memory channels if Redis not available
USE_IN_MEMORY_CHANNELS=False

# Email Configuration (for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Logging
LOG_LEVEL=INFO

# JWT Token Settings
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800
